{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Bolts: one Rust game process in us-west-2a behind CloudFront VPC origin; retained encrypted storage and SSM administration.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Default": "vpc-b000bdd5"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Default": "subnet-239e3554"
    },
    "AmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Pinned AL2023 x86_64 AMI. Existing deployments retain this value to prevent implicit replacement."
    },
    "CloudFrontPrefixList": {
      "Type": "String",
      "Default": "pl-82a045eb",
      "AllowedPattern": "pl-[a-f0-9]+"
    },
    "CloudFrontServiceSecurityGroup": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|sg-[a-f0-9]+",
      "Description": "Filled after VPC origin creation to restrict ingress to the AWS-managed service SG."
    },
    "CustomDomainName": {
      "Type": "String",
      "Default": "",
      "AllowedValues": ["", "bolts-api.christopherkrapu.com"]
    },
    "CustomDomainCertificateArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|arn:aws:acm:us-east-1:[0-9]{12}:certificate/[a-f0-9-]+",
      "Description": "Certificate output from the separate us-east-1 edge certificate stack."
    },
    "CustomDomainHostedZoneId": {
      "Type": "String",
      "Default": "",
      "AllowedValues": ["", "Z00983602PMUH0CDXDTFC"]
    },
    "AllowedOrigins": {
      "Type": "String",
      "Default": "https://play-bolts.github.io,http://127.0.0.1:5173,http://localhost:5173",
      "AllowedPattern": "[A-Za-z0-9:/.,_-]+"
    }
  },
  "Conditions": {
    "UseCustomDomain": {
      "Fn::Not": [{"Fn::Equals": [{"Ref": "CustomDomainName"}, ""]}]
    },
    "UseServiceSecurityGroup": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CloudFrontServiceSecurityGroup"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "StorageBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireBackups",
              "Status": "Enabled",
              "Prefix": "backups/",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "ExpireReleases",
              "Status": "Enabled",
              "Prefix": "releases/",
              "ExpirationInDays": 90,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Bolts"
          },
          {
            "Key": "Component",
            "Value": "MultiplayerBackend"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "StoragePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "StorageBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "StorageBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${StorageBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "BoltsReleaseAndBackup",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${StorageBucket.Arn}/releases/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": {
                    "Fn::Sub": "${StorageBucket.Arn}/backups/${AWS::StackName}/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Bolts"
          },
          {
            "Key": "Component",
            "Value": "MultiplayerBackend"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "InstanceSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Bolts: only CloudFront origin traffic; no SSH or public application ingress",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "SSM, encrypted S3 backups, and signed package/toolchain downloads"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Bolts"
          },
          {
            "Key": "Component",
            "Value": "MultiplayerBackend"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "ApplicationIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "InstanceSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourcePrefixListId": {
          "Fn::If": [
            "UseServiceSecurityGroup",
            {
              "Ref": "AWS::NoValue"
            },
            {
              "Ref": "CloudFrontPrefixList"
            }
          ]
        },
        "SourceSecurityGroupId": {
          "Fn::If": [
            "UseServiceSecurityGroup",
            {
              "Ref": "CloudFrontServiceSecurityGroup"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Description": "CloudFront private VPC-origin connection"
      }
    },
    "GameServer": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "t3.small",
        "PropagateTagsToVolumeOnCreation": true,
        "AvailabilityZone": "us-west-2a",
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "MetadataOptions": {
          "HttpEndpoint": "enabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 30,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "DeleteOnTermination": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Fn::GetAtt": [
                  "InstanceSecurityGroup",
                  "GroupId"
                ]
              }
            ]
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\n# CloudFormation Fn::Sub expands only the explicitly named template parameters.\nset -euo pipefail\numask 077\ndnf install -y gcc gcc-c++ make tar gzip sqlite python3 curl-minimal awscli-2\nsystemctl enable --now amazon-ssm-agent\nid bolts >/dev/null 2>&1 || useradd --system --home-dir /var/lib/bolts --shell /sbin/nologin bolts\nid bolts-build >/dev/null 2>&1 || useradd --system --home-dir /opt/bolts-build --shell /sbin/nologin bolts-build\ninstall -d -m 0755 -o root -g root /opt/bolts /opt/bolts/releases\ninstall -d -m 0700 -o bolts -g bolts /var/lib/bolts /var/lib/bolts-backup\ninstall -d -m 0700 -o bolts-build -g bolts-build /opt/bolts-build\nif [ ! -f /etc/bolts.env ]; then\n  cat > /etc/bolts.env <<'BOLTS_CONFIG'\nBOLTS_BIND=0.0.0.0:8080\nBOLTS_DB=/var/lib/bolts/bolts.sqlite\nBOLTS_ORIGINS=${AllowedOrigins}\nBOLTS_TRUST_PROXY=true\nBOLTS_EMPTY_SECONDS=300\nBOLTS_RECONNECT_SECONDS=30\nBOLTS_MAX_ROOMS=6\nRUST_LOG=bolts_server=info,tower_http=warn\nAWS_DEFAULT_REGION=${AWS::Region}\nBOLTS_BACKUP_BUCKET=${StorageBucket}\nBOLTS_BACKUP_PREFIX=backups/${AWS::StackName}\nBOLTS_CONFIG\n  python3 - <<'PY'\nimport secrets\nwith open('/etc/bolts.env', 'a') as config:\n    config.write('BOLTS_IDENTITY_SALT=' + secrets.token_hex(32) + '\\n')\nPY\n  chmod 0600 /etc/bolts.env\nfi\n# Rust's release linker can briefly exceed 2 GiB. Swap remains encrypted on EBS.\nif [ ! -f /swapfile ]; then\n  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none\n  chmod 0600 /swapfile\n  mkswap /swapfile >/dev/null\n  swapon /swapfile\n  echo '/swapfile none swap sw 0 0' >> /etc/fstab\nfi\ntouch /var/lib/bolts-bootstrap.ready\n"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Bolts"
          },
          {
            "Key": "Component",
            "Value": "MultiplayerBackend"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-game-server"
            }
          },
          {
            "Key": "BoltsStack",
            "Value": {
              "Ref": "AWS::StackId"
            }
          }
        ]
      }
    },
    "PrivateOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "DependsOn": [
        "ApplicationIngress"
      ],
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${GameServer}"
          },
          "Name": {
            "Fn::Sub": "${AWS::StackName}-game-server"
          },
          "HTTPPort": 8080,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only",
          "OriginSSLProtocols": [
            "TLSv1.2"
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Bolts"
          },
          {
            "Key": "Component",
            "Value": "MultiplayerBackend"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "NoCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-no-cache"
          },
          "Comment": "Never cache authentication, lobby, health, or WebSocket responses",
          "DefaultTTL": 0,
          "MaxTTL": 0,
          "MinTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "RequestPolicy": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-websocket-and-cors"
          },
          "Comment": "Forward WebSocket upgrade, Origin, X-Forwarded-For, and viewer address",
          "CookiesConfig": {
            "CookieBehavior": "none"
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "whitelist",
            "QueryStrings": ["minutes"]
          },
          "HeadersConfig": {
            "HeaderBehavior": "allViewerAndWhitelistCloudFront",
            "Headers": [
              "CloudFront-Viewer-Address",
              "CloudFront-Forwarded-Proto"
            ]
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Bolts multiplayer backend: private Oregon EC2 origin",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "bolts-backend",
              "DomainName": {
                "Fn::GetAtt": [
                  "GameServer",
                  "PrivateDnsName"
                ]
              },
              "ConnectionAttempts": 3,
              "ConnectionTimeout": 10,
              "VpcOriginConfig": {
                "VpcOriginId": {
                  "Fn::GetAtt": [
                    "PrivateOrigin",
                    "Id"
                  ]
                },
                "OriginReadTimeout": 60,
                "OriginKeepaliveTimeout": 60
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "bolts-backend",
            "ViewerProtocolPolicy": "https-only",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS",
              "PUT",
              "PATCH",
              "POST",
              "DELETE"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "CachePolicyId": {
              "Ref": "NoCachePolicy"
            },
            "OriginRequestPolicyId": {
              "Ref": "RequestPolicy"
            },
            "Compress": false
          },
        "Aliases": {
          "Fn::If": ["UseCustomDomain", [{"Ref": "CustomDomainName"}], {"Ref": "AWS::NoValue"}]
        },
        "ViewerCertificate": {
          "Fn::If": [
            "UseCustomDomain",
            {
              "AcmCertificateArn": {"Ref": "CustomDomainCertificateArn"},
              "SslSupportMethod": "sni-only",
              "MinimumProtocolVersion": "TLSv1.2_2021"
            },
            {"CloudFrontDefaultCertificate": true}
          ]
        },
          "Restrictions": {
            "GeoRestriction": {
              "RestrictionType": "none"
            }
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Bolts"
          },
          {
            "Key": "Component",
            "Value": "MultiplayerBackend"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "BackendAliasA": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "UseCustomDomain",
      "Properties": {
        "HostedZoneId": {"Ref": "CustomDomainHostedZoneId"},
        "Name": {"Ref": "CustomDomainName"},
        "Type": "A",
        "AliasTarget": {
          "DNSName": {"Fn::GetAtt": ["Distribution", "DomainName"]},
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "BackendAliasAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Condition": "UseCustomDomain",
      "Properties": {
        "HostedZoneId": {"Ref": "CustomDomainHostedZoneId"},
        "Name": {"Ref": "CustomDomainName"},
        "Type": "AAAA",
        "AliasTarget": {
          "DNSName": {"Fn::GetAtt": ["Distribution", "DomainName"]},
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "GameServer"
      }
    },
    "StorageBucket": {
      "Value": {
        "Ref": "StorageBucket"
      }
    },
    "SecurityGroupId": {
      "Value": {
        "Fn::GetAtt": [
          "InstanceSecurityGroup",
          "GroupId"
        ]
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "VpcOriginId": {
      "Value": {
        "Fn::GetAtt": [
          "PrivateOrigin",
          "Id"
        ]
      }
    },
    "BackendUrl": {
      "Value": {
        "Fn::If": [
          "UseCustomDomain",
          {"Fn::Sub": "https://${CustomDomainName}"},
          {"Fn::Sub": "https://${Distribution.DomainName}"}
        ]
      }
    },
    "CloudFrontUrl": {
      "Value": {"Fn::Sub": "https://${Distribution.DomainName}"}
    },
    "AvailabilityZone": {
      "Value": {
        "Fn::GetAtt": [
          "GameServer",
          "AvailabilityZone"
        ]
      }
    },
    "IngressMode": {
      "Value": {
        "Fn::If": [
          "UseServiceSecurityGroup",
          "CloudFront service security group",
          "CloudFront managed prefix list"
        ]
      }
    },
    "RootVolumeRetention": {
      "Value": "Encrypted 30 GiB gp3 root volume is retained when the instance is terminated."
    }
  }
}
